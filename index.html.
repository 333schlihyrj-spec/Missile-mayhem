<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width,
initial-scale=1.0,
maximum-scale=1.0,
user-scalable=no">

<title>Missile Mayhem 3D</title>

<style>

* {
    box-sizing: border-box;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
}

body {
    margin: 0;
    overflow: hidden;
    background: #02040a;
    font-family: Arial, sans-serif;
}

canvas {
    display: block;
}

/* HUD */

#hud {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    padding: 15px;
    display: flex;
    justify-content: space-between;
    color: white;
    z-index: 10;
    pointer-events: none;
}

.logo {
    color: #5eeaff;
    font-size: 22px;
    font-weight: bold;
    text-shadow: 0 0 15px #00aaff;
}

.stats {
    display: flex;
    gap: 15px;
}

.stats span {
    color: #ffd43b;
    font-weight: bold;
}

/* WAVE */

#waveMessage {
    position: fixed;
    top: 45%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: white;
    z-index: 20;
    opacity: 0;
    pointer-events: none;
    transition: .4s;
}

#waveMessage.show {
    opacity: 1;
}

#waveNumber {
    font-size: 70px;
    font-weight: bold;
    color: #5eeaff;
    text-shadow:
        0 0 15px #00aaff,
        0 0 40px #0088ff;
}

#waveText {
    font-size: 20px;
}

/* START / GAME OVER */

.screen {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.8);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 50;
}

.box {
    width: min(500px,90%);
    padding: 30px;
    text-align: center;
    border: 2px solid #405070;
    border-radius: 20px;
    background: #0b1324;
    color: white;
}

.box h1 {
    margin: 0;
    color: #5eeaff;
    font-size: clamp(38px,9vw,65px);
    text-shadow:
        0 0 15px #00aaff,
        0 0 40px #0066ff;
}

.box h2 {
    color: #ff4438;
}

.box p {
    line-height: 1.6;
    color: #b8c5da;
}

button {
    border: 0;
    cursor: pointer;
}

.startButton {
    padding: 15px 35px;
    border-radius: 12px;
    background: #5eeaff;
    color: #001018;
    font-size: 20px;
    font-weight: bold;
}

/* MOBILE BUTTONS */

#controls {
    position: fixed;
    bottom: 15px;
    left: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    gap: 20px;
    z-index: 30;
}

.control {
    width: 120px;
    height: 90px;
    border-radius: 20px;
    border: 2px solid #526887;
    background: rgba(20,35,60,.9);
    color: white;
    box-shadow: 0 6px 0 #05080d;
    touch-action: none;
}

.control:active {
    transform: translateY(6px);
    box-shadow: 0 1px 0 #05080d;
}

.arrow {
    display: block;
    font-size: 38px;
    line-height: 35px;
}

.label {
    font-size: 12px;
    color: #aebbd0;
}

#gameOver {
    display: none;
}

@media(max-width:500px) {

    .logo {
        font-size: 15px;
    }

    .stats {
        font-size: 11px;
        gap: 7px;
    }

    .control {
        width: 110px;
        height: 80px;
    }

}

</style>
</head>

<body>

<!-- 3D GAME -->

<div id="game"></div>


<!-- HUD -->

<div id="hud">

    <div class="logo">
        🚀 MISSILE MAYHEM
    </div>

    <div class="stats">

        SCORE:
        <span id="score">0</span>

        WAVE:
        <span id="wave">1</span>

        ❤️
        <span id="lives">3</span>

    </div>

</div>


<!-- WAVE MESSAGE -->

<div id="waveMessage">

    <div id="waveNumber">
        WAVE 1
    </div>

    <div id="waveText">
        GET READY!
    </div>

</div>


<!-- START SCREEN -->

<div id="startScreen" class="screen">

    <div class="box">

        <h1>
            MISSILE<br>
            MAYHEM
        </h1>

        <h2>
            🚀 3D
        </h2>

        <p>
            Jump over missiles!
            <br>
            Duck under missiles!
            <br><br>
            Survive as many waves as you can!
        </p>

        <button
            class="startButton"
            id="startButton">

            START GAME

        </button>

    </div>

</div>


<!-- GAME OVER -->

<div id="gameOver" class="screen">

    <div class="box">

        <h1>
            💥 BOOM!
        </h1>

        <h2>
            GAME OVER
        </h2>

        <p id="finalScore">
            Score: 0
        </p>

        <p id="finalWave">
            Wave: 1
        </p>

        <button
            class="startButton"
            id="restartButton">

            PLAY AGAIN

        </button>

    </div>

</div>


<!-- MOBILE CONTROLS -->

<div id="controls">

    <button
        class="control"
        id="jumpButton">

        <span class="arrow">↑</span>
        <span class="label">JUMP</span>

    </button>

    <button
        class="control"
        id="duckButton">

        <span class="arrow">↓</span>
        <span class="label">DUCK</span>

    </button>

</div>


<!-- THREE.JS -->

<script src="https://cdn.jsdelivr.net/npm/three@0.161.0/build/three.min.js"></script>


<script>

/* ==========================================
   MISSILE MAYHEM 3D
========================================== */


/* SCENE */

const scene =
    new THREE.Scene();

scene.background =
    new THREE.Color(0x020611);

scene.fog =
    new THREE.Fog(
        0x020611,
        30,
        180
    );


/* CAMERA */

const camera =
    new THREE.PerspectiveCamera(
        70,
        window.innerWidth /
        window.innerHeight,
        .1,
        500
    );

camera.position.set(
    0,
    5,
    13
);


/* RENDERER */

const renderer =
    new THREE.WebGLRenderer({
        antialias:true
    });

renderer.setSize(
    window.innerWidth,
    window.innerHeight
);

renderer.setPixelRatio(
    Math.min(
        window.devicePixelRatio,
        2
    )
);

renderer.shadowMap.enabled = true;

document
    .getElementById("game")
    .appendChild(renderer.domElement);


/* ==========================================
   LIGHTS
========================================== */

const ambient =
    new THREE.AmbientLight(
        0x8899bb,
        1.5
    );

scene.add(ambient);


const sun =
    new THREE.DirectionalLight(
        0xffffff,
        2
    );

sun.position.set(
    -10,
    20,
    10
);

sun.castShadow = true;

scene.add(sun);


const redLight =
    new THREE.PointLight(
        0xff3322,
        5,
        40
    );

redLight.position.set(
    0,
    5,
    0
);

scene.add(redLight);


/* ==========================================
   STARS
========================================== */

const starGeometry =
    new THREE.BufferGeometry();

const starPositions = [];

for(let i=0;i<800;i++){

    starPositions.push(
        (Math.random()-.5)*250,
        Math.random()*100,
        (Math.random()-.5)*250
    );

}

starGeometry.setAttribute(
    "position",
    new THREE.Float32BufferAttribute(
        starPositions,
        3
    )
);

const starMaterial =
    new THREE.PointsMaterial({
        color:0xffffff,
        size:.35
    });

const stars =
    new THREE.Points(
        starGeometry,
        starMaterial
    );

scene.add(stars);


/* ==========================================
   MOON
========================================== */

const moon =
    new THREE.Mesh(

        new THREE.SphereGeometry(
            7,
            32,
            32
        ),

        new THREE.MeshBasicMaterial({
            color:0xfff1bd
        })

    );

moon.position.set(
    35,
    35,
    -100
);

scene.add(moon);


/* ==========================================
   GROUND
========================================== */

const ground =
    new THREE.Mesh(

        new THREE.PlaneGeometry(
            180,
            500
        ),

        new THREE.MeshStandardMaterial({
            color:0x17202e,
            roughness:1
        })

    );

ground.rotation.x =
    -Math.PI/2;

ground.position.y =
    -2;

ground.position.z =
    -100;

ground.receiveShadow = true;

scene.add(ground);


/* ==========================================
   ROAD LINES
========================================== */

for(
    let z=0;
    z>-300;
    z-=10
){

    const line =
        new THREE.Mesh(

            new THREE.BoxGeometry(
                .25,
                .05,
                4
            ),

            new THREE.MeshBasicMaterial({
                color:0x3c4d68
            })

        );

    line.position.set(
        0,
        -1.94,
        z
    );

    scene.add(line);

}


/* ==========================================
   CREATE MISSILE
========================================== */

function createMissile(){

    const missile =
        new THREE.Group();


    /* BODY */

    const body =
        new THREE.Mesh(

            new THREE.CylinderGeometry(
                .55,
                .55,
                3,
                16
            ),

            new THREE.MeshStandardMaterial({
                color:0xff3028,
                metalness:.6,
                roughness:.3
            })

        );

    body.rotation.z =
        Math.PI/2;

    missile.add(body);


    /* NOSE */

    const nose =
        new THREE.Mesh(

            new THREE.ConeGeometry(
                .55,
                1.2,
                16
            ),

            new THREE.MeshStandardMaterial({
                color:0xff3b30
            })

        );

    nose.rotation.z =
        -Math.PI/2;

    nose.position.x =
        2;

    missile.add(nose);


    /* FINS */

    for(
        let side of [-1,1]
    ){

        const fin =
            new THREE.Mesh(

                new THREE.BoxGeometry(
                    .8,
                    .12,
                    .8
                ),

                new THREE.MeshStandardMaterial({
                    color:0x8e1118
                })

            );

        fin.position.x =
            -1;

        fin.position.z =
            side*.5;

        missile.add(fin);

    }


    /* FLAME */

    const flame =
        new THREE.Mesh(

            new THREE.ConeGeometry(
                .4,
                1.5,
                12
            ),

            new THREE.MeshBasicMaterial({
                color:0xffaa22
            })

        );

    flame.rotation.z =
        Math.PI/2;

    flame.position.x =
        -2.2;

    missile.add(flame);


    /* LIGHT */

    const glow =
        new THREE.PointLight(
            0xff4422,
            5,
            10
        );

    glow.position.x =
        -2;

    missile.add(glow);


    return missile;

}


/* ==========================================
   PLAYER
========================================== */

const player =
    new THREE.Group();

player.position.set(
    0,
    0,
    5
);

scene.add(player);


/* HEAD */

const head =
    new THREE.Mesh(

        new THREE.SphereGeometry(
            .55,
            20,
            20
        ),

        new THREE.MeshStandardMaterial({
            color:0x5eeaff,
            emissive:0x164d5a
        })

    );

head.position.y =
    2.5;

player.add(head);


/* BODY */

const body =
    new THREE.Mesh(

        new THREE.BoxGeometry(
            .8,
            1.3,
            .6
        ),

        new THREE.MeshStandardMaterial({
            color:0x26aabd
        })

    );

body.position.y =
    1.5;

player.add(body);


/* LEGS */

for(
    let side of [-1,1]
){

    const leg =
        new THREE.Mesh(

            new THREE.BoxGeometry(
                .25,
                .9,
                .25
            ),

            new THREE.MeshStandardMaterial({
                color:0x197e94
            })

        );

    leg.position.set(
        side*.25,
        .6,
        0
    );

    player.add(leg);

}


/* ARMS */

for(
    let side of [-1,1]
){

    const arm =
        new THREE.Mesh(

            new THREE.BoxGeometry(
                .22,
                1,
                .22
            ),

            new THREE.MeshStandardMaterial({
                color:0x5eeaff
            })

        );

    arm.position.set(
        side*.58,
        1.5,
        0
    );

    player.add(arm);

}


/* PLAYER MISSILE */

const playerMissile =
    createMissile();

playerMissile.scale.set(
    .8,
    .8,
    .8
);

playerMissile.position.y =
    .1;

player.add(
    playerMissile
);


/* ==========================================
   GAME VARIABLES
========================================== */

let running = false;

let alive = true;

let score = 0;

let lives = 3;

let wave = 1;

let playerY = 0;

let velocityY = 0;

let ducking = false;

let missiles = [];

let spawnTimer = 0;

let waveMissiles = 0;

let waveComplete = false;

let waveDelay = 0;

let cameraShake = 0;

let lastTime =
    performance.now();


/* ==========================================
   WAVE DIFFICULTY
========================================== */

function settings(){

    return {

        amount:
            5 + (wave-1)*2,

        speed:
            18 + (wave-1)*2.5,

        spawn:
            Math.max(
                .32,
                .9-(wave-1)*.04
            )

    };

}


/* ==========================================
   SPAWN MISSILE
========================================== */

function spawnMissile(){

    const s =
        settings();

    const missile =
        createMissile();


    /* THREE LANES */

    const lane =
        Math.floor(
            Math.random()*3
        )-1;


    /*
      LOW = JUMP
      HIGH = DUCK
    */

    const high =
        Math.random()<.35;


    missile.position.set(

        lane*3,

        high
            ? 3.1
            : 0,

        -110

    );


    missile.rotation.y =
        Math.PI;


    scene.add(
        missile
    );


    missiles.push({

        mesh:missile,

        speed:
            s.speed *
            (.85+
            Math.random()*.3),

        high:high,

        checked:false

    });


    waveMissiles++;

}


/* ==========================================
   JUMP
========================================== */

function jump(){

    if(
        !running ||
        !alive
    ) return;


    if(
        playerY<=.05
    ){

        velocityY =
            12;

        ducking =
            false;

    }

}


/* ==========================================
   DUCK
========================================== */

function duckStart(){

    if(
        !running ||
        !alive
    ) return;


    /*
      You can duck even while
      falling from a jump.
    */

    ducking = true;

}


function duckStop(){

    ducking = false;

}


/* ==========================================
   PLAYER UPDATE
========================================== */

function updatePlayer(delta){

    /* GRAVITY */

    velocityY -=
        30*delta;

    playerY +=
        velocityY*delta;


    if(
        playerY<=0
    ){

        playerY=0;

        velocityY=0;

    }


    player.position.y =
        playerY;


    /* DUCK */

    const target =
        ducking ? .55 : 1;

    player.scale.y +=
        (target-player.scale.y)
        *Math.min(delta*15,1);


    /* MISSILE BOB */

    playerMissile.rotation.z =
        Math.sin(
            performance.now()*.004
        )*.04;

}


/* ==========================================
   COLLISION
========================================== */

function hitTest(m){

    const dx =
        Math.abs(
            m.mesh.position.x -
            player.position.x
        );

    const dz =
        Math.abs(
            m.mesh.position.z -
            player.position.z
        );


    if(
        dx>2.2 ||
        dz>2.5
    ){

        return false;

    }


    /*
      LOW MISSILE

      Jump high enough = safe.
    */

    if(
        !m.high
    ){

        if(
            playerY>1.3
        ){

            return false;

        }

        return true;

    }


    /*
      HIGH MISSILE

      Duck = safe.
    */

    if(
        m.high
    ){

        if(
            ducking
        ){

            return false;

        }

        return true;

    }


    return false;

}


/* ==========================================
   EXPLOSION
========================================== */

function explosion(position){

    const material =
        new THREE.MeshBasicMaterial({
            color:0xff7722,
            transparent:true,
            opacity:1
        });


    const geometry =
        new THREE.SphereGeometry(
            1,
            16,
            16
        );


    const blast =
        new THREE.Mesh(
            geometry,
            material
        );


    blast.position.copy(
        position
    );


    scene.add(
        blast
    );


    let size=1;


    function animate(){

        size+=.18;

        material.opacity-=.07;

        blast.scale.setScalar(
            size
        );


        if(
            material.opacity<=0
        ){

            scene.remove(
                blast
            );

            geometry.dispose();

            material.dispose();

            return;

        }


        requestAnimationFrame(
            animate
        );

    }


    animate();

}


/* ==========================================
   HIT PLAYER
========================================== */

function playerHit(){

    lives--;

    document.getElementById(
        "lives"
    ).textContent =
        lives;


    explosion(
        player.position.clone()
    );


    cameraShake =
        .5;


    if(
        lives<=0
    ){

        gameOver();

    }

}


/* ==========================================
   UPDATE MISSILES
========================================== */

function updateMissiles(delta){

    for(
        let i=missiles.length-1;
        i>=0;
        i--
    ){

        const m =
            missiles[i];


        m.mesh.position.z +=
            m.speed*delta;


        /*
          When missile reaches
          player.
        */

        if(
            !m.checked &&
            m.mesh.position.z>2
        ){

            m.checked=true;


            if(
                hitTest(m)
            ){

                playerHit();

            }
            else{

                score++;

                document.getElementById(
                    "score"
                ).textContent =
                    score;

            }

        }


        /*
          Delete old missiles.
        */

        if(
            m.mesh.position.z>20
        ){

            scene.remove(
                m.mesh
            );

            missiles.splice(
                i,
                1
            );

        }

    }

}


/* ==========================================
   START WAVE
========================================== */

function startWave(){

    const s =
        settings();


    waveMissiles=0;

    waveComplete=false;


    showWave(
        "WAVE "+wave,
        wave===1
            ? "GET READY!"
            : "MISSILES INCOMING!"
    );

}


/* ==========================================
   WAVE MESSAGE
========================================== */

function showWave(
    title,
    text
){

    const box =
        document.getElementById(
            "waveMessage"
        );


    document.getElementById(
        "waveNumber"
    ).textContent =
        title;


    document.getElementById(
        "waveText"
    ).textContent =
        text;


    box.classList.add(
        "show"
    );


    setTimeout(
        ()=>{
            box.classList.remove(
                "show"
            );
        },
        1500
    );

}


/* ==========================================
   CHECK WAVE
========================================== */

function checkWave(){

    if(
        waveComplete
    ) return;


    const s =
        settings();


    if(
        waveMissiles>=s.amount &&
        missiles.length===0
    ){

        waveComplete=true;

        waveDelay=2;

    }

}


/* ==========================================
   SPAWN SYSTEM
========================================== */

function spawning(delta){

    if(
        waveComplete
    ){

        waveDelay-=delta;


        if(
            waveDelay<=0
        ){

            wave++;

            document.getElementById(
                "wave"
            ).textContent =
                wave;

            startWave();

        }

        return;

    }


    const s =
        settings();


    spawnTimer+=delta;


    if(
        waveMissiles<s.amount &&
        spawnTimer>=s.spawn
    ){

        spawnMissile();

        spawnTimer=0;

    }

}


/* ==========================================
   GAME OVER
========================================== */

function gameOver(){

    running=false;

    alive=false;

    ducking=false;


    document.getElementById(
        "finalScore"
    ).textContent =
        "Score: "+score;


    document.getElementById(
        "finalWave"
    ).textContent =
        "Wave: "+wave;


    document.getElementById(
        "gameOver"
    ).style.display =
        "flex";

}


/* ==========================================
   RESET
========================================== */

function reset(){

    missiles.forEach(
        m=>{
            scene.remove(
                m.mesh
            );
        }
    );


    missiles=[];


    score=0;

    lives=3;

    wave=1;

    playerY=0;

    velocityY=0;

    ducking=false;

    waveMissiles=0;

    waveComplete=false;

    waveDelay=0;

    spawnTimer=0;

    alive=true;

    running=true;


    player.position.y=0;

    player.scale.y=1;


    document.getElementById(
        "score"
    ).textContent=0;


    document.getElementById(
        "lives"
    ).textContent=3;


    document.getElementById(
        "wave"
    ).textContent=1;


    document.getElementById(
        "gameOver"
    ).style.display="none";


    startWave();

}


/* ==========================================
   KEYBOARD
========================================== */

document.addEventListener(
    "keydown",
    event=>{

        if(
            event.code==="ArrowUp"
        ){

            event.preventDefault();

            jump();

        }


        if(
            event.code==="ArrowDown"
        ){

            event.preventDefault();

            duckStart();

        }

    }
);


document.addEventListener(
    "keyup",
    event=>{

        if(
            event.code==="ArrowDown"
        ){

            event.preventDefault();

            duckStop();

        }

    }
);


/* ==========================================
   MOBILE JUMP
========================================== */

const jumpButton =
    document.getElementById(
        "jumpButton"
    );


jumpButton.addEventListener(
    "pointerdown",
    event=>{

        event.preventDefault();

        jump();

    }
);


/* ==========================================
   MOBILE DUCK
========================================== */

const duckButton =
    document.getElementById(
        "duckButton"
    );


duckButton.addEventListener(
    "pointerdown",
    event=>{

        event.preventDefault();

        duckButton.setPointerCapture(
            event.pointerId
        );

        duckStart();

    }
);


duckButton.addEventListener(
    "pointerup",
    event=>{

        event.preventDefault();

        duckStop();

    }
);


duckButton.addEventListener(
    "pointercancel",
    duckStop
);


/* ==========================================
   START BUTTON
========================================== */

document.getElementById(
    "startButton"
).onclick=()=>{

    document.getElementById(
        "startScreen"
    ).style.display="none";

    reset();

};


/* ==========================================
   RESTART
========================================== */

document.getElementById(
    "restartButton"
).onclick=()=>{

    reset();

};


/* ==========================================
   CAMERA
========================================== */

function updateCamera(delta){

    if(
        cameraShake>0
    ){

        cameraShake-=delta;

        camera.position.x =
            (Math.random()-.5)
            *cameraShake;

        camera.position.y =
            5+
            (Math.random()-.5)
            *cameraShake;

    }
    else{

        camera.position.x *= .9;

        camera.position.y +=
            (5-camera.position.y)
            *.1;

    }

}


/* ==========================================
   MAIN GAME LOOP
========================================== */

function loop(time){

    requestAnimationFrame(
        loop
    );


    const delta =
        Math.min(
            (time-lastTime)/1000,
            .05
        );


    lastTime=time;


    if(
        running
    ){

        updatePlayer(delta);

        updateMissiles(delta);

        spawning(delta);

        checkWave();

        updateCamera(delta);

    }


    stars.rotation.y +=
        delta*.01;


    renderer.render(
        scene,
        camera
    );

}


requestAnimationFrame(
    loop
);


/* ==========================================
   WINDOW RESIZE
========================================== */

window.addEventListener(
    "resize",
    ()=>{

        camera.aspect =
            window.innerWidth /
            window.innerHeight;

        camera.updateProjectionMatrix();

        renderer.setSize(
            window.innerWidth,
            window.innerHeight
        );

    }
);

</script>

